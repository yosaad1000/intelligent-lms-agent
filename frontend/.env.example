# LMS Frontend Environment Configuration
# Copy this to .env.local and configure with your actual values

# ===========================================
# DEVELOPMENT MODE (Mock Data - Quick Start)
# ===========================================
VITE_NODE_ENV=development
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_AGENT=false
VITE_USE_API_PROXY=true
VITE_USE_DUMMY_DATA=true

# ===========================================
# PRODUCTION MODE (Real AI Agent & APIs)
# ===========================================
# Uncomment and set to false to enable real features:
# VITE_USE_MOCK_AUTH=false
# VITE_USE_MOCK_AGENT=false
# VITE_USE_DUMMY_DATA=false

# ===========================================
# AWS CONFIGURATION (Replace with your values)
# ===========================================
VITE_AWS_REGION=us-east-1

# Your Bedrock Agent (Replace with your agent ID)
VITE_BEDROCK_AGENT_ID=your_bedrock_agent_id_here
VITE_BEDROCK_AGENT_ALIAS_ID=your_agent_alias_here

# Your API Endpoints (Replace with your API Gateway URLs)
VITE_API_GATEWAY_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod
VITE_WEBSOCKET_URL=wss://your-websocket-url.execute-api.us-east-1.amazonaws.com/prod
VITE_DOCUMENTS_BUCKET=your-documents-bucket-name

# ===========================================
# AUTHENTICATION (Replace with your Supabase project)
# ===========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# TESTING & DEBUG
# ===========================================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true